# Copy to .env and fill in. NEVER commit .env or the *.session file - they give full access to your Telegram account.

# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# The "RVRC Credit Bot Updates" channel: its @username or numeric id.
# Run `python -m credit_sniper --list-chats` to find it.
CHANNEL=

# The bot you DM to claim (from the t.me/... link in the channel posts)
BOT_USERNAME=rccredits_bot

# Which meals to auto-claim: breakfast, dinner, or both
MEALS=breakfast,dinner

# Start with true and watch the logs; switch to false to actually claim.
DRY_RUN=true

# Successful claims per meal per day (you can only eat one dinner - extras would be wasted)
MAX_CLAIMS_PER_MEAL_PER_DAY=1
# Total /claim messages per meal per day, including lost races
MAX_ATTEMPTS_PER_MEAL_PER_DAY=6

# Rate limiting (applies to every message sent to the bot). Minimum allowed gap is 2s.
MIN_SECONDS_BETWEEN_SENDS=4
MAX_SENDS_PER_HOUR=15

# Random delay before each claim, in seconds. Zero-latency claims look robotic.
CLAIM_DELAY_MIN=0.4
CLAIM_DELAY_MAX=1.2

# Seconds to wait for the bot's answer
REPLY_TIMEOUT=20
# Ignore posts older than this (e.g. delivered late after a reconnect)
MAX_POST_AGE_SECONDS=90

# Send yourself a note in Saved Messages on claims / problems
NOTIFY_SAVED_MESSAGES=true

SESSION_NAME=credit_sniper
STATE_FILE=state.json
TIMEZONE=Asia/Singapore
